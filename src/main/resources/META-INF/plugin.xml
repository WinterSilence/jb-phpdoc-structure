<idea-plugin>
    <id>afedonyuk.plugins.phpdoc.structure.color</id>
    <name>PHPDoc Structure Color</name>
    <vendor url="https://github.com/wintersilence">Fedonyuk Anton</vendor>
    <description><![CDATA[Colors properties and methods declared with PhpDoc tags in the Structure view.]]></description>
    <change-notes><![CDATA[Fix bug: read access is allowed from inside read-action only.]]></change-notes>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>
    <dependencies>
        <module name="intellij.platform.structureView.impl"/>
    </dependencies>
    <extensions defaultExtensionNs="com.intellij">
        <lang.psiStructureViewFactory language="PHP" implementationClass="phpdoc.structure.PhpDocStructureViewFactory" order="first"/>
        <projectConfigurable parentId="reference.webide.settings.project.settings.php" instance="phpdoc.structure.PhpDocColorConfigurable" id="phpdoc.structure.color.settings" displayName="PhpDoc Structure"/>
    </extensions>
</idea-plugin>
