<idea-plugin>
    <id>phpdoc.structure.color</id>
    <name>PhpDoc Structure Color</name>
    <vendor url="https://github.com/wintersilence">Fedonyuk Anton</vendor>
    <description><![CDATA[Colors properties and methods declared with PhpDoc tags in the Structure view.]]></description>
    <change-notes><![CDATA[Initial release.]]></change-notes>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>
    <dependencies>
        <module name="intellij.platform.structureView.impl"/>
    </dependencies>
    <extensions defaultExtensionNs="com.intellij">
        <lang.psiStructureViewFactory language="PHP" implementationClass="phpdoc.structure.PhpDocStructureViewFactory" order="first"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/light.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/dark.xml"/>
    </extensions>
</idea-plugin>

